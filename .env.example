# Copy to .env and fill in. Never commit real values.

# Server: Gemini cloud reading (POST /api/extract)
GEMINI_API_KEY=
GEMINI_MODEL=

# Server: share store (Supabase table "shares")
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Browser: Google Identity Services OAuth client for Gmail import
VITE_GOOGLE_CLIENT_ID=

# Browser: true = in-memory mock services, false = real services
VITE_USE_MOCK=true

# Server port (the Vite dev server proxies /api here)
PORT=8787
